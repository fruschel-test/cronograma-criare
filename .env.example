# Copie este arquivo para .env.local e preencha com os dados do projeto Supabase.
# Use somente a URL e a chave publishable/anon do projeto.
# NUNCA coloque service_role, senha do banco ou outras chaves secretas no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_SUPABASE